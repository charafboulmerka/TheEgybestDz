<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:ctx=".DetailsActivity"
    tools:showIn="@layout/activity_details"
    android:keepScreenOn="true">


    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                >


                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/image_thumby"
                    android:layout_width="140dp"
                    android:layout_height="210dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="25dp"
                    android:scaleType="fitXY"
                    app:riv_corner_radius="5dip"
                    app:riv_mutate_background="true"
                    android:background="@color/black_1_transarent"/>

                <!--<ImageView
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_outline_play_circle_filled_24px"
                    android:layout_width="38dp"
                    android:layout_height="38dp" />-->


                <LinearLayout
                    android:id="@+id/l1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="30dp"
                    android:layout_toEndOf="@id/image_thumby"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:background="@color/black_1_transarent"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="@dimen/spacing_medium"
                        android:layout_height="0dp" />

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@color/black_1_transarent" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/black_1_transarent"
                        />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/download"
                        android:textColor="@color/black"
                        android:backgroundTint="@color/white"
                        android:visibility="gone"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_below="@id/l1"
                    >


                    <View
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:background="@color/black_1_transarent"/>

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="20dp"
                android:background="@color/black_1_transarent"/>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>


    <RelativeLayout
        android:id="@+id/play"
        android:layout_below="@+id/shimmer_view_container"
        android:background="@color/black"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/radioPlayImage"
            android:layout_alignParentTop="true"
            android:background="@color/black"
            android:clickable="false"
            android:layout_width="@dimen/logoW"
            android:layout_height="@dimen/logoH"
            android:focusable="true"
            android:visibility="gone"
            tools:visibility="visible"
            android:src="@drawable/icon1"/>


        <FrameLayout
            android:id="@+id/player_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.exoplayer2.ui.PlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:controller_layout_id="@layout/custom_exo_layout" />



            <com.google.android.exoplayer2.ui.SubtitleView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>


        <WebView
            android:id="@+id/webView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ImageView
            android:id="@+id/img_back"
            android:paddingTop="10dp"
            android:paddingStart="10dp"
            android:paddingLeft="10dp"
            android:layout_alignParentTop="true"
            app:srcCompat="@drawable/ic_action_back_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/media_route_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:mediaRouteTypes="user"
            app:mediaRouteButtonTint="@color/white"
            android:padding="5dp"
            android:visibility="gone"
            />



        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_outline_play_circle_filled_24px"
            android:layout_width="50dp"
            android:layout_height="50dp" />


    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout"
        android:layout_below="@+id/play"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:descendantFocusability="beforeDescendants"
            android:focusableInTouchMode="true"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/description_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:scaleType="centerCrop">
                    <ImageView
                        android:id="@+id/poster_iv"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/image_16"/>

                    <ImageView
                        android:id="@+id/cover_darkness"
                        android:alpha="0.78"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/gradient_white_transparent"/>

                </RelativeLayout>



<!--
                    <com.balysv.materialripple.MaterialRippleLayout
                        android:id="@+id/lyt_parent"
                        android:layout_width="match_parent"
                        android:layout_height="350dp"
                        android:background="@drawable/gradient_white_transparent"
                        android:paddingTop="10dp"
                        android:paddingLeft="15dp">

-->
                        <RelativeLayout
                            android:id="@+id/lyt_parent"
                            android:layout_width="match_parent"
                            android:layout_height="350dp"
                            android:paddingTop="10dp"
                            android:paddingLeft="15dp">

                            <ImageButton
                                android:id="@+id/des_back_iv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="5dp"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/ic_action_back_arrow" />

                            <androidx.appcompat.widget.Toolbar
                                android:orientation="vertical"
                                android:layout_width="100dp"
                                android:layout_height="45dp"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/rounded_toolbar_background">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="right">

                                    <ImageButton
                                        android:id="@+id/add_fav"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:background="?android:selectableItemBackground"
                                        android:visibility="visible"
                                        app:srcCompat="@drawable/ic_favorite_border_white"
                                        android:layout_marginStart="5dp"/>

                                    <ImageButton
                                        android:id="@+id/share_iv2"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:layout_weight="1"
                                        android:visibility="visible"
                                        android:layout_marginRight="8dp"
                                        app:srcCompat="@drawable/ic_share_white" />

                                </LinearLayout>

                            </androidx.appcompat.widget.Toolbar>


                            <!--<ImageView
                                android:layout_centerInParent="true"
                                android:src="@drawable/ic_outline_play_circle_filled_24px"
                                android:layout_width="38dp"
                                android:layout_height="38dp" />-->


                            <com.makeramen.roundedimageview.RoundedImageView
                                android:id="@+id/image_thumb"
                                android:layout_width="140dp"
                                android:layout_height="210dp"
                                android:layout_alignParentBottom="true"
                                android:layout_marginBottom="25dp"
                                android:scaleType="fitXY"
                                app:riv_corner_radius="5dip"
                                app:riv_mutate_background="true"
                                tools:src="@drawable/album_art_placeholder_large" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="20dp"
                                android:layout_marginBottom="30dp"
                                android:layout_toRightOf="@id/image_thumb"
                                android:orientation="vertical"
                                android:padding="3dp"
                                android:layout_marginEnd="15dp">

                                <TextView
                                    android:id="@+id/text_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="Two Line"
                                    android:layout_margin="5dp"
                                    android:textColor="@android:color/white"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="@dimen/spacing_medium"
                                    android:layout_height="0dp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="fill_parent"
                                    android:orientation="horizontal">
                                    <LinearLayout
                                        android:id="@+id/float_btns"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="start"
                                        android:orientation="vertical">

                                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                                            android:id="@+id/watch_now_bt"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:tint="@color/white"
                                            android:scaleType="center"
                                            app:fabSize="auto"
                                            app:rippleColor="@color/colorAccent"
                                            app:srcCompat="@drawable/ic_play" />

                                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                                            android:id="@+id/download_bt"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:tint="@color/white"
                                            android:scaleType="center"
                                            app:fabSize="auto"
                                            android:layout_marginTop="6dp"
                                            app:backgroundTint="@color/red_600"
                                            app:srcCompat="@drawable/ic_download" />


                                    </LinearLayout>
                                    <TextView
                                        android:id="@+id/genre_tv"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:layout_marginTop="5dp"
                                        android:ellipsize="end"
                                        android:gravity="right"
                                        android:layout_gravity="right"
                                        android:maxLines="5"
                                        tools:text="بوالمرقة شرا الدين شراففف شرف"
                                        android:textColor="@color/white"/>


                                </LinearLayout>




                                <Button
                                    android:id="@+id/watch_now_bt2"
                                    android:layout_width="match_parent"
                                    android:layout_height="55dp"
                                    android:visibility="gone"
                                    android:layout_marginTop="8dp"
                                    android:backgroundTint="@color/colorPrimary"
                                    android:text="@string/watch_now"
                                    android:textColor="@color/white"
                                    />

                                <Button
                                    android:id="@+id/download_bt2"
                                    android:layout_width="match_parent"
                                    android:layout_height="55dp"
                                    android:layout_marginTop="5dp"
                                    android:visibility="gone"
                                    android:text="@string/download"
                                    android:textColor="@color/black"
                                    android:backgroundTint="@color/white"
                                    />


                            </LinearLayout>

                        </RelativeLayout>



               <!--     </com.balysv.materialripple.MaterialRippleLayout> -->

                </RelativeLayout>

                <Button
                    android:id="@+id/btn_report_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="تـبـلـيغ عن خـلـل؟"
                    android:gravity="center"
                    android:padding="3dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:minHeight="10dp"
                    android:textColor="@color/red_600"
                    android:textStyle="bold"
                    android:background="@drawable/btn_rounded_light"/>


                <RelativeLayout
                    android:id="@+id/series_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:visibility="gone"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/seriest_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="series title"
                        android:textSize="18sp"/>

                    <ImageView
                        android:id="@+id/add_fav2"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/outline_favorite_border_24" />

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/llbottomparent"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <LinearLayout
                        android:id="@+id/spinner_container"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/gray_border_back"
                        >

                        <Spinner
                            android:id="@+id/season_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            />

                    </LinearLayout>




                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_server_list"
                        android:layout_width="match_parent"
                        android:nestedScrollingEnabled="false"
                        android:layout_height="wrap_content"
                        >

                    </androidx.recyclerview.widget.RecyclerView>




                    <RelativeLayout
                        android:id="@+id/adView"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:visibility="gone"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>


                    <include layout="@layout/adfalcon_banner"/>
                    <include layout="@layout/startapp_banner"/>
                    <!--
                    <include layout="@layout/inmobi_banner"/>
-->
                    <LinearLayout
                        android:padding="10dp"
                        android:layout_marginTop="5dp"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_details"
                            android:textAppearance="@style/TextAppearance.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:gravity="right"
                            android:lineSpacingExtra="2dp"
                            android:layout_gravity="right"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llbottom"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="10dp"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:gravity="right"
                            android:layout_height="wrap_content">


                            <TextView
                                android:id="@+id/tv_director"
                                android:textAppearance="@style/TextAppearance.Medium.Bold"
                                android:layout_marginRight="10dp"
                                android:layout_toLeftOf="@id/director"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="fsqfqsfsqfsqf"
                                android:layout_marginStart="10dp" />

                            <TextView
                                android:id="@+id/director"
                                android:textAppearance="@style/TextAppearance.Medium.Bold"
                                android:text="@string/director"
                                android:gravity="right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:visibility="gone"
                                android:layout_toLeftOf="@id/director"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/director">

                            </androidx.recyclerview.widget.RecyclerView>

                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_release_date"
                                android:textAppearance="@style/TextAppearance.Medium.Bold"
                                android:layout_width="match_parent"
                                android:gravity="right"
                                android:layout_height="wrap_content" />

                        </RelativeLayout>


                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:text="@string/genre"
                                android:textAppearance="@style/TextAppearance.Medium.Bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:id="@+id/tv_genre"
                                android:textAppearance="@style/TextAppearance.Small"
                                android:layout_width="match_parent"
                                android:gravity="right"
                                android:layout_gravity="right"
                                android:layout_height="wrap_content" />


                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/cast_label"
                                android:text="@string/cast_n_crew"
                                android:textAppearance="@style/TextAppearance.Medium.Bold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                            <TextView
                                android:id="@+id/tv_cast"
                                android:textAppearance="@style/TextAppearance.Small"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"/>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/cast_rv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/download_text"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="4dp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:text="@string/external_download_links"
                                />

                        </LinearLayout>

                    </LinearLayout>
                    <View
                        android:layout_marginTop="5dp"
                        android:background="@color/grey_transparent"
                        android:layout_width="match_parent"
                        android:layout_height="1px"/>


                    <TextView
                        android:id="@+id/tv_related"
                        android:textAppearance="@style/TextAppearance.Title"
                        android:padding="10dp"
                        android:text="@string/you_may_also_like"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_related"
                        android:layout_width="match_parent"
                        android:layout_marginBottom="10dp"
                        android:layout_height="wrap_content">

                    </androidx.recyclerview.widget.RecyclerView>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/llcomments"
                    android:padding="10dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="@string/comments"
                        android:textAppearance="@style/TextAppearance.Medium.Bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <EditText
                        android:id="@+id/et_comment"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/comment_et_border"
                        android:padding="10dp"
                        android:hint="@string/your_comments"
                        android:layout_width="match_parent"
                        android:layout_height="70dp" />
                    <Button
                        android:id="@+id/btn_comment"
                        android:layout_gravity="right"
                        android:textColor="@color/colorPrimary"
                        android:text="@string/add_comments"
                        android:textAllCaps="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </androidx.recyclerview.widget.RecyclerView>

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


</RelativeLayout>